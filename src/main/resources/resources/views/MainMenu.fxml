<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane id="backgroundPane" prefHeight="400.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.comp2042.MainMenuController">
    <stylesheets>
        <URL value="@styling.css" />
    </stylesheets>
    <children>
        <VBox fx:id="mainMenuPanel" alignment="CENTER" spacing="22.0">
            <Label id="title" alignment="CENTER" contentDisplay="CENTER" prefHeight="52.0" prefWidth="500.0" text="Snake Game" textAlignment="CENTER" />
            <Button fx:id="btn_start" minHeight="40.0" minWidth="150.0" mnemonicParsing="false" onAction="#handleStart" prefHeight="40.0" prefWidth="150.0" styleClass="startAndQuitBtn" text="Start" textFill="WHITE" />
            <Button fx:id="btn_options" minHeight="40.0" minWidth="150.0" mnemonicParsing="false" onAction="#handleOpenOptions" prefHeight="40.0" prefWidth="150.0" styleClass="startAndQuitBtn" text="Options" textFill="WHITE" />
            <Button fx:id="btn_exit_game" minHeight="40.0" minWidth="150.0" mnemonicParsing="false" onAction="#handleExitGame" prefHeight="40.0" prefWidth="150.0" styleClass="startAndQuitBtn" text="Exit Game" textFill="WHITE" />
        </VBox>
        <VBox fx:id="optionsPanel" alignment="CENTER" managed="false" spacing="15.0" visible="false">
            <Label id="optionsTitle" alignment="CENTER" prefHeight="42.0" prefWidth="500.0" text="OPTIONS" textAlignment="CENTER" />
            <Label id="displayModeLabel" alignment="CENTER" text="Display mode" textAlignment="CENTER" />
            <ComboBox fx:id="displayModeChoice" id="displayModeChoice" prefHeight="38.0" prefWidth="245.0" />
            <Label fx:id="displayModeStatus" id="displayModeStatus" alignment="CENTER" text="Applied: Fullscreen" textAlignment="CENTER" />
            <HBox alignment="CENTER" spacing="16.0">
                <Button fx:id="btn_apply" minHeight="40.0" minWidth="150.0" mnemonicParsing="false" onAction="#handleApplyOptions" prefHeight="40.0" prefWidth="150.0" styleClass="startAndQuitBtn" text="Apply" textFill="WHITE" />
                <Button fx:id="btn_back" minHeight="40.0" minWidth="150.0" mnemonicParsing="false" onAction="#handleBackToMenu" prefHeight="40.0" prefWidth="150.0" styleClass="startAndQuitBtn" text="Back" textFill="WHITE" />
            </HBox>
        </VBox>
    </children>
</StackPane>
